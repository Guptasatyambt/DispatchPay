# Copy to .env for local development. .env is git-ignored.
DB_NAME=dispatchpay
DB_USERNAME=dispatchpay
DB_PASSWORD=change-me-locally
DB_PORT=5432

# At least 32 characters each. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-32-plus-chars
OTP_PEPPER=replace-with-another-random-secret-32-plus-chars
